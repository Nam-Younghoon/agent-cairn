# 하네스 레포 자체 개발용 .gitignore
# (대상 프로젝트용은 templates/gitignore.partial 참조)

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Claude Code 로컬 상태
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# 에디터
.idea/
.vscode/
*.swp

# 브랜치 전용 작업 문서 (리모트 푸시 금지)
__docs/
# 단, templates/__docs/ 는 소비자 프로젝트로 배포되는 **원본 자산**이라 추적해야 한다.
# 위 규칙은 깊이를 가리지 않아 여기까지 배제하므로 디렉토리 자체를 되살린다
# (git 은 부모가 배제된 상태에서 내부 파일만 되살릴 수 없다).
!templates/__docs/

# git worktree (멀티 세션 격리) — 레포 내부에 생성되므로 추적 제외 (ADR-016/018)
.claude/worktrees/
.worktrees/
